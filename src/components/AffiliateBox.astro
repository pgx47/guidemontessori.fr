---
import { amazonUrl } from '../site.config';

interface Props {
  asin: string;
  nom: string;
  pointsForts: string[];
  pointsFaibles: string[];
  image?: string;
  prix?: string;
  ctaUrl?: string;
}

const { asin, nom, pointsForts, pointsFaibles, image, prix, ctaUrl } = Astro.props;
const href = ctaUrl || amazonUrl(asin);
---

<div class="not-prose my-8 flex flex-col overflow-hidden rounded-2xl border-2 border-orange-100 bg-white shadow-sm sm:flex-row">
  <div class="flex shrink-0 items-center justify-center border-b border-stone-200 bg-[#FBF9F5] p-6 sm:w-1/3 sm:border-b-0 sm:border-r">
    {image ? (
      <img src={image} alt={nom} loading="lazy" class="max-h-44 w-full max-w-44 object-contain" />
    ) : (
      <div class="flex h-32 w-32 items-center justify-center text-5xl">📦</div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-6">
    <p class="font-serif text-xl font-bold text-gray-900">{nom}</p>
    {prix && <p class="mt-1 text-sm font-semibold text-terracotta-600">{prix}</p>}
    <div class="my-4 grid flex-1 gap-4 md:grid-cols-2">
      <div class="rounded-xl bg-sage-50 p-4 text-sage-800">
        <p class="mb-2 font-semibold">Points forts</p>
        <ul class="space-y-1 text-sm">{pointsForts.map((pt) => <li>+ {pt}</li>)}</ul>
      </div>
      <div class="rounded-xl bg-red-50 p-4 text-red-800">
        <p class="mb-2 font-semibold">Points faibles</p>
        <ul class="space-y-1 text-sm">{pointsFaibles.map((pt) => <li>− {pt}</li>)}</ul>
      </div>
    </div>
    <a
      href={href}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="mt-auto inline-block rounded-full px-6 py-3 text-center font-semibold text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg"
      style="background: linear-gradient(135deg, #e8956a, #d4764e)"
    >
      Voir la disponibilité et le prix sur Amazon
    </a>
  </div>
</div>
