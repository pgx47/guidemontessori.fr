---
import fs from 'node:fs';
import sharp from 'sharp';
import type { CollectionEntry } from 'astro:content';
import { ogCardVersion } from '../lib/og';
import { formatDate } from '../site.config';

interface Props {
  entry: CollectionEntry<'guides' | 'news'>;
  border?: string;
  fallbackBg?: string;
  showDate?: boolean;
}

const { entry, border = 'border-orange-100', fallbackBg = '#f5f0e8', showDate = false } = Astro.props;
const { title, description, image, emoji, publishDate } = entry.data;
const href = `/${entry.collection === 'news' ? 'actualites' : 'articles'}/${entry.id}/`;

const collectionPath = entry.collection === 'news' ? 'actualites' : 'articles';
const ogPath = `/og/${collectionPath}/${entry.id}.jpg`;
const ogSrc = ogCardVersion(ogPath);

const imageStr = typeof image === 'string' ? image : '';
const isRemote = /^https?:\/\//i.test(imageStr);
const isLocal = imageStr.startsWith('/');
const localExists = isLocal && fs.existsSync(`public${imageStr}`);
const ogExists = fs.existsSync(`public${ogPath}`);

// Image locale (existe sur le disque) -> <picture> WebP + <img>.
const renderLocal = isLocal && localExists;
// URL distante -> <img> tel quel (normalisation des entités HTML).
const renderRemote = isRemote;
// Aucune image locale : on préfère la carte OG générée (stable, hébergée chez nous)
// à un hotlink distant (presse, disponibilité et droits non maîtrisés).
const renderOg = !renderLocal && ogExists;

const remoteSrc = renderRemote ? imageStr.replace(/&amp;/g, '&') : '';

let webpSrcset = '';
if (renderLocal) {
  const base = imageStr.replace(/\.(png|jpe?g|webp)$/i, '');
  const variants = [`${base}-640.webp`, `${base}.webp`];
  const sized: { path: string; width: number }[] = [];
  for (const candidate of variants) {
    if (!fs.existsSync(`public${candidate}`)) continue;
    try {
      const meta = await sharp(`public${candidate}`).metadata();
      if (meta.width) sized.push({ path: candidate, width: meta.width });
    } catch {
      // variante illisible : ignorée
    }
  }
  webpSrcset = sized
    .sort((a, b) => a.width - b.width)
    .map((v) => `${v.path} ${v.width}w`)
    .join(', ');
}
const hasWebp = webpSrcset.length > 0;

// Repli typographique : initiale de catégorie (l'emoji n'est qu'un dernier recours).
const fallbackGlyph = entry.collection === 'news' ? 'A' : 'G';
---

<a
  href={href}
  class:list={['group block h-full overflow-hidden rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl', border]}
  style="background-color: #fffcf8"
>
  {
    renderLocal ? (
      <div class="aspect-[16/10] overflow-hidden">
        {
          hasWebp ? (
            <picture class="block h-full w-full">
              <source type="image/webp" srcset={webpSrcset} sizes="(min-width: 768px) 33vw, 100vw" />
              <img src={imageStr} alt={title} width="640" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </picture>
          ) : (
            <img src={imageStr} alt={title} width="640" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          )
        }
      </div>
    ) : renderOg || renderRemote ? (
      <div class="aspect-[16/10] overflow-hidden">
        <img src={renderOg ? ogSrc : remoteSrc} alt={title} width="640" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
    ) : (
      <div class="flex aspect-[16/10] items-center justify-center" style={`background: ${fallbackBg}`}>
        <span class="font-serif text-7xl font-bold text-sage-600/40" aria-hidden="true">{fallbackGlyph || emoji}</span>
      </div>
    )
  }
  <div class="p-5">
    {showDate && <p class="mb-2 text-xs text-sage-700"><time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time></p>}
    <h3 class="mb-1 font-serif text-lg font-bold text-gray-800 transition-colors group-hover:text-sage-600">{title}</h3>
    <p class="line-clamp-2 text-sm text-gray-600">{description}</p>
  </div>
</a>
