---
import { affiliateUrl } from '../site.config';
import type { Book } from '../data/books';

interface Props {
  book: Book;
  badgeClass?: string;
}

const { book, badgeClass = 'bg-sage-100 text-sage-700' } = Astro.props;
const isParent = book.targetAudience === 'parent';
---

<article class="flex gap-5 overflow-hidden rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-shadow duration-300 hover:shadow-md">
  <div class="shrink-0">
    {book.image ? (
      <img src={book.image} alt={`Couverture ${book.title}`} loading="lazy"
           class="aspect-[2/3] w-28 rounded-lg object-cover shadow-md sm:w-32" />
    ) : (
      <div class="flex aspect-[2/3] w-28 items-center justify-center rounded-lg bg-sage-100 p-3 text-center text-xs font-bold text-sage-700 shadow-md sm:w-32">
        {book.title}
      </div>
    )}
  </div>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="mb-2 flex items-start justify-between gap-3">
      <div class="min-w-0">
        {(isParent ? book.level : book.category) && (
          <span class:list={['mb-1 inline-block rounded-full px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-widest', badgeClass]}>
            {isParent ? book.level : book.category}
          </span>
        )}
        <h3 class="line-clamp-2 text-lg font-bold leading-snug text-gray-900">{book.title}</h3>
        <p class="mb-2 mt-0.5 text-xs font-medium text-gray-500">{isParent ? book.author : book.ageRange}</p>
      </div>
    </div>

    <p class="mb-4 line-clamp-3 flex-grow text-sm leading-relaxed text-gray-700">{book.description}</p>

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-stone-100 pt-3">
      <span class="text-base font-extrabold text-gray-900">{book.price}</span>
      <a href={affiliateUrl(book.amazonUrl)} target="_blank" rel="nofollow sponsored noopener"
         class="rounded-lg bg-amber-800 px-3 py-2 text-xs font-semibold text-white transition hover:bg-amber-900">
        Acheter sur Amazon ↗
      </a>
    </div>
  </div>
</article>
