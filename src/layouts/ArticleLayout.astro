---
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { render } from 'astro:content';
import { SITE, formatDate, affiliateUrl } from '../site.config';
import { ogImagePath } from '../lib/og';
import type { Entry } from '../lib/content';

interface Props {
  entry: Entry;
  related: Entry[];
  section: { label: string; href: string };
}

const { entry, related, section } = Astro.props;
const { title, description, keywords, image, emoji, publishDate, updatedDate, author, amazonUrl, faq } = entry.data;
const url = new URL(Astro.url.pathname, SITE.url).toString();
const { headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const wordCount = (entry.body ?? '')
  .replace(/<[^>]*>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

const ogCard = ogImagePath(Astro.url.pathname);
// Illustration : carte OG générée en priorité (locale, 1200×630, légère), sinon image de l'article.
const heroImage = ogCard ?? image;
---

<BaseLayout title={title} description={description} keywords={keywords} image={image} type="article" publishDate={publishDate} updatedDate={updatedDate}>
  <SeoSchema
    slot="head"
    type="article"
    path={Astro.url.pathname}
    title={title}
    description={description}
    image={ogCard ?? image}
    publishDate={publishDate}
    updatedDate={updatedDate}
    author={author}
    faq={faq}
    breadcrumbs={[
      { name: 'Accueil', url: '/' },
      { name: section.label, url: section.href },
      { name: title, url: Astro.url.pathname },
    ]}
    articleSection={section.label}
    wordCount={wordCount}
    keywords={keywords}
  />
  <article class="min-h-screen py-12" style="background-color: #fffcf8" itemscope itemtype="https://schema.org/Article">
    <div class="mx-auto max-w-3xl px-4">
      <nav class="mb-8 text-sm text-gray-500" aria-label="Fil d'Ariane">
        <ol class="flex flex-wrap items-center" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" itemprop="item" class="hover:text-sage-600"><span itemprop="name">Accueil</span></a><span aria-hidden="true"> / </span><meta itemprop="position" content="1" />
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href={section.href} itemprop="item" class="hover:text-sage-600"><span itemprop="name">{section.label}</span></a><span aria-hidden="true"> / </span><meta itemprop="position" content="2" />
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name" class="text-gray-700">{title}</span><meta itemprop="position" content="3" />
          </li>
        </ol>
      </nav>

      <header class="mb-10 text-center">
        {!heroImage && <div class="mb-4 text-6xl">{emoji}</div>}
        <h1 class="mb-4 font-serif text-3xl font-bold text-gray-900 md:text-4xl" itemprop="headline">{title}</h1>
        {heroImage && (
          <img
            src={heroImage}
            alt={title}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="mx-auto mb-8 aspect-[16/9] w-full rounded-2xl object-cover"
          />
        )}
        <p class="text-sm text-gray-500">
          Publié le <time itemprop="datePublished" datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
          {updatedDate && <>{' · Mis à jour le '}<time itemprop="dateModified" datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
          {` · ${author}`}
        </p>
      </header>

      {toc.length > 1 && (
        <nav class="mb-10 rounded-2xl border border-stone-200 bg-[#FBF9F5] p-6" aria-label="Sommaire">
          <p class="mb-3 text-xs font-extrabold uppercase tracking-widest text-terracotta-600">Sommaire de l'article</p>
          <ol class="space-y-2 text-sm text-gray-700">
            {toc.map((h, i) => (
              <li>
                <a href={`#${h.slug}`} class="flex items-baseline gap-2 transition-colors hover:text-terracotta-600">
                  <span class="text-xs font-bold text-terracotta-500">{i + 1}.</span>
                  <span>{h.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose max-w-none">
        <slot />
      </div>

      {
        faq?.length ? (
          <section class="mt-12">
            <h2 class="mb-6 font-serif text-2xl font-bold text-sage-600">Questions fréquentes</h2>
            <div class="space-y-3">
              {faq.map((f) => (
                <details class="rounded-xl border border-orange-100 bg-white p-4">
                  <summary class="cursor-pointer font-semibold text-gray-800">{f.question}</summary>
                  <p class="mt-3 text-gray-700">{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        ) : null
      }

      <div class="mt-10 border-t border-gray-200 pt-8">
        <ShareButtons title={title} description={description} url={url} />
      </div>

      {
        amazonUrl && (
          <div class="relative mt-10 overflow-hidden rounded-3xl border-2 border-orange-100 p-8 text-center" style="background: linear-gradient(135deg, #fce8d5, #f5e6d0)">
            <p class="mb-3 font-serif text-2xl font-bold text-gray-800">Prêt à Offrir ce Matériel à Votre Enfant ?</p>
            <p class="mx-auto mb-6 max-w-lg text-gray-600">Retrouvez notre sélection sur Amazon avec livraison rapide et retours gratuits.</p>
            <a
              href={affiliateUrl(amazonUrl)}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="inline-block rounded-full px-8 py-3 text-lg font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl"
              style="background: linear-gradient(135deg, #e8956a, #d4764e)"
            >
              Voir notre recommandation sur Amazon →
            </a>
            <p class="mt-4 text-xs text-gray-400">
              En tant que Partenaire Amazon, nous percevons une rémunération sur les achats qualifiants. Cela ne change pas le prix pour vous.
            </p>
          </div>
        )
      }

      {
        related.length > 0 && (
          <section class="mt-14">
            <h2 class="mb-6 text-center font-serif text-2xl font-bold text-gray-800">À lire aussi</h2>
            <div class="grid gap-6 md:grid-cols-3">
              {related.map((r) => <ArticleCard entry={r} />)}
            </div>
          </section>
        )
      }

      <div class="mt-10 text-center">
        <a href={section.href} class="text-sage-600 hover:underline">← Retour : {section.label}</a>
      </div>
    </div>
  </article>
</BaseLayout>
