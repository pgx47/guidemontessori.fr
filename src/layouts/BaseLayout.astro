---
import '../styles/global.css';
import SeoSchema from '../components/SeoSchema.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  noindex?: boolean;
}

const { title, description = SITE.description, keywords = [], image, type = 'website', publishDate, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL(image ?? '/hero-1.png', SITE.url).toString();

const nav = [
  { href: '/articles/', label: 'Guides' },
];
const books = [
  { href: '/lectures-parents/', label: 'Lectures Parents' },
  { href: '/livres-enfants/', label: 'Livres Enfants' },
];
const legal = [
  { href: '/mentions-legales/', label: 'Mentions Légales' },
  { href: '/politique-confidentialite/', label: 'Politique de Confidentialité' },
  { href: '/politique-cookies/', label: 'Politique de Cookies' },
  { href: '/cgv/', label: 'CGU' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {type === 'website' && <SeoSchema type="website" />}
    <slot name="head" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 border-b border-[#e8ddd0] bg-[#f5f0e8]/90 backdrop-blur-sm">
      <div class="relative mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="flex items-center gap-2">
          <svg class="h-7 w-7 shrink-0" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect x="13" y="4" width="6" height="6" rx="1" fill="#E88B97"/>
            <rect x="10" y="12" width="12" height="8" rx="1.5" fill="#DC6B7A"/>
            <rect x="7" y="22" width="18" height="7" rx="1.5" fill="#CF4D5E"/>
          </svg>
          <span class="font-serif text-2xl font-bold text-sage-600">GuideMontessori<span class="text-terracotta-500">.fr</span></span>
        </a>
        <nav class="hidden items-center gap-4 text-gray-600 md:flex lg:gap-6">
          {nav.map((l) => <a href={l.href} class="transition-colors hover:text-sage-600">{l.label}</a>)}
          <div class="group relative">
            <span class="cursor-pointer transition-colors hover:text-sage-600">Livres ▾</span>
            <div class="invisible absolute left-0 top-full min-w-[180px] rounded-lg bg-white py-2 opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100">
              {books.map((l) => <a href={l.href} class="block px-4 py-2 text-sm hover:bg-sage-50">{l.label}</a>)}
            </div>
          </div>
          <a href="/ecoles/" class="transition-colors hover:text-sage-600">Écoles</a>
          <a href="/cadeaux/" class="transition-colors hover:text-sage-600">Cadeaux</a>
          <a href="/bons-plans/" class="rounded-full bg-terracotta-500 px-4 py-1.5 text-sm font-bold text-white transition-colors hover:bg-terracotta-600">Promos</a>
        </nav>
        <details class="md:hidden">
          <summary class="cursor-pointer list-none p-2 text-gray-600 hover:text-sage-600" aria-label="Menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </summary>
          <nav class="absolute left-0 right-0 top-full flex flex-col space-y-3 border-b border-sage-200 bg-white px-6 py-4 shadow-lg">
            {nav.map((l) => <a href={l.href} class="py-2 text-gray-700 hover:text-sage-600">{l.label}</a>)}
            {books.map((l) => <a href={l.href} class="py-2 pl-4 text-sm text-gray-700 hover:text-sage-600">{l.label}</a>)}
            <a href="/ecoles/" class="py-2 text-gray-700 hover:text-sage-600">Écoles</a>
            <a href="/cadeaux/" class="py-2 text-gray-700 hover:text-sage-600">Cadeaux</a>
            <a href="/bons-plans/" class="py-2 font-bold text-terracotta-600 hover:text-terracotta-700">Promos</a>
          </nav>
        </details>
      </div>
    </header>

    <main class="flex-1"><slot /></main>

    <footer class="bg-sage-800 border-t-4 border-terracotta-300 py-12 text-white">
      <div class="mx-auto max-w-6xl px-4">
        <div class="mb-8 grid gap-8 md:grid-cols-4">
          <div class="md:col-span-2">
            <p class="mb-3 font-serif text-xl">GuideMontessori<span class="text-terracotta-500">.fr</span></p>
            <p class="text-sm leading-relaxed text-sage-300">
              Votre guide de confiance pour une parentalité éclairée et bienveillante. Nous vous accompagnons dans la découverte du matériel pédagogique Montessori.
            </p>
          </div>
          <div>
            <p class="mb-4 font-semibold text-sage-100">Navigation</p>
            <ul class="space-y-2 text-sm text-sage-300">
              {[...nav, ...books, { href: '/actualites/', label: 'Actualités' }, { href: '/ecoles/', label: 'Écoles' }, { href: '/cadeaux/', label: 'Cadeaux' }, { href: '/bons-plans/', label: 'Promos' }, { href: '/a-propos/', label: 'À propos' }, { href: '/contact/', label: 'Contact' }].map((l) => (
                <li><a href={l.href} class="transition-colors hover:text-white">{l.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="mb-4 font-semibold text-sage-100">Informations Légales</p>
            <ul class="space-y-2 text-sm text-sage-300">
              {legal.map((l) => <li><a href={l.href} class="transition-colors hover:text-white">{l.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="border-t border-sage-700 pt-6 text-center">
          <p class="text-sm text-sage-300">© {new Date().getFullYear()} GuideMontessori.fr - Tous droits réservés.</p>
          <p class="mt-2 text-xs text-sage-400">
            Ce site participe au Programme Partenaires Amazon EU, un programme d'affiliation conçu pour permettre à des sites de percevoir une rémunération grâce à la création de liens vers Amazon.fr.
          </p>
        </div>
      </div>
        <div class="border-t border-sage-700/60 px-4 py-3 text-center text-[11px] text-sage-400">
      Nos autres sites : <a href="https://streamlib.fr" class="text-sage-300 hover:text-white transition-colors">StreamLib</a> &middot; <a href="https://missstream.xyz" class="text-sage-300 hover:text-white transition-colors">missstream</a> &middot; <a href="https://streamgen.fr" class="text-sage-300 hover:text-white transition-colors">StreamGen</a>
    </div>
  </footer>
  </body>
</html>
