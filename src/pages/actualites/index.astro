---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getNews } from '../../lib/content';
import { SITE } from '../../site.config';

const news = await getNews();

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Actualités Montessori',
  itemListElement: news.map((n, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: n.data.title,
    url: `${SITE.url}/actualites/${n.id}/`,
  })),
};
---

<BaseLayout title="Actualités Montessori : écoles, crèches et recherches" description="Les dernières actualités de la pédagogie Montessori : écoles, crèches, études, recherches et initiatives pour la petite enfance, décryptées pour les parents.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />
  <section class="min-h-screen bg-sand-50 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-12 text-center">
        <h1 class="mb-4 font-serif text-4xl font-bold">Actualités Montessori</h1>
        <p class="mx-auto max-w-2xl text-gray-600">Brèves, nouveautés et tendances autour de la pédagogie Montessori.</p>
      </div>
      {
        news.length ? (
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {news.map((n) => <ArticleCard entry={n} showDate border="border-sky-100" fallbackBg="linear-gradient(135deg, #d6eaff, #d1f0dd)" />)}
          </div>
        ) : (
          <p class="text-center text-gray-500">Les premières actualités arrivent bientôt.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
