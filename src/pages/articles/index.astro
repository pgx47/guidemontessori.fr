---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getGuides } from '../../lib/content';
import { SITE } from '../../site.config';

const guides = await getGuides();

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Guides Montessori',
  itemListElement: guides.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.data.title,
    url: `${SITE.url}/articles/${g.id}/`,
  })),
};
---

<BaseLayout title="Guides Montessori : matériel, activités et conseils" description="Tous nos guides sur le matériel Montessori : tour rose, lettres rugueuses, vie pratique, globe… pour accompagner l'autonomie de votre enfant à la maison.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />
  <section class="min-h-screen bg-sand-50 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-12 text-center">
        <h1 class="mb-4 font-serif text-4xl font-bold">Tous nos Guides Montessori</h1>
        <p class="mx-auto max-w-2xl text-gray-600">Des articles détaillés pour comprendre et choisir le bon matériel pour votre enfant.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => <ArticleCard entry={g} showDate />)}
      </div>
    </div>
  </section>
</BaseLayout>
