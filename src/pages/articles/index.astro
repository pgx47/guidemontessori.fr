---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getGuides } from '../../lib/content';

const guides = await getGuides();
---

<BaseLayout title="Tous les Articles" description="Découvrez tous nos guides sur le matériel Montessori : Globe, Lettres Rugueuses, Tour Rose, et bien plus encore.">
  <section class="min-h-screen bg-sand-50 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-12 text-center">
        <h1 class="mb-4 font-serif text-4xl font-bold">Tous nos Guides Montessori</h1>
        <p class="mx-auto max-w-2xl text-gray-600">Des articles détaillés pour comprendre et choisir le bon matériel pour votre enfant.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => <ArticleCard entry={g} showDate />)}
      </div>
    </div>
  </section>
</BaseLayout>
