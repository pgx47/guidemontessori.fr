---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getGuides, getNews } from '../lib/content';
import { SITE } from '../site.config';

const [guides, news] = await Promise.all([getGuides(), getNews()]);

const guidesItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Guides Montessori',
  itemListElement: guides.slice(0, 6).map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.data.title,
    url: `${SITE.url}/articles/${g.id}/`,
  })),
};

const ages = [
  { age: '0–12 mois', title: 'Les premières découvertes', text: 'Observer, toucher et explorer à son rythme.', href: '/articles/mobile-munari/', number: '01' },
  { age: '1–3 ans', title: 'Faire par soi-même', text: 'Des gestes simples pour grandir en autonomie.', href: '/articles/vie-pratique/', number: '02' },
  { age: '3–6 ans', title: 'Apprendre avec ses sens', text: 'Manipuler, comparer et découvrir le langage.', href: '/articles/tour-rose/', number: '03' },
  { age: '6 ans et plus', title: 'Explorer le monde', text: 'Nourrir la curiosité avec la géographie.', href: '/articles/globe-montessori/', number: '04' },
];
---

<BaseLayout
  title="Montessori à la maison : activités et matériel par âge"
  description="Guides Montessori pour les 0-6 ans : activités par âge, choix du matériel et conseils concrets pour favoriser l'autonomie de votre enfant à la maison."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(guidesItemList)} />
  <section class="home-hero">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
      <div>
        <p class="eyebrow">Grandir ensemble, simplement</p>
        <h1 class="mt-5 text-4xl leading-tight md:text-5xl lg:text-6xl">Montessori à la maison,<br /><span class="text-sage-700">un pas à la fois.</span></h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-gray-600">Des activités concrètes, des repères pour choisir le matériel et des idées pour accompagner l’autonomie de votre enfant. À son rythme, et au vôtre.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-cta" href="/articles/">Découvrir les guides <span aria-hidden="true">→</span></a>
          <a class="home-secondary" href="#par-age">Choisir selon son âge</a>
        </div>
        <p class="mt-7 text-sm text-sage-700">{guides.length} guides à explorer · Accès gratuit · Pour les parents curieux</p>
      </div>
      <div class="relative">
        <img src="/images/montessori-maison.webp" alt="Enfant manipulant les cubes de la tour rose Montessori" width="1024" height="1024" fetchpriority="high" class="aspect-[5/4] w-full rounded-[2rem] object-cover" />
        <div class="hero-note"><span class="block text-xs uppercase tracking-widest text-sage-700">Notre fil conducteur</span><p class="mt-2 font-serif text-lg">Observer. Proposer.<br />Laisser essayer.</p></div>
      </div>
    </div>
  </section>

  <section id="par-age" class="scroll-mt-24 border-y border-sand-300 bg-sand-100 py-14">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow">À chaque étape, de nouvelles possibilités</p>
      <h2 class="mt-3 text-2xl md:text-3xl">Par où commencer avec votre enfant ?</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {ages.map((item) => <a href={item.href} class="age-card group">
          <div class="flex items-center justify-between"><span class="text-sm font-semibold text-sage-700">{item.age}</span><span aria-hidden="true" class="font-serif text-2xl text-sand-400">{item.number}</span></div>
          <h3 class="mt-5 text-lg group-hover:text-sage-700">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{item.text}</p>
          <span class="mt-5 block text-sm font-semibold text-terracotta-700">Explorer <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="section-heading"><div><p class="eyebrow">À lire, à essayer, à partager</p><h2 class="mt-3 text-2xl md:text-3xl">Les derniers guides Montessori</h2></div><a href="/articles/" class="text-sm font-semibold text-sage-700 hover:underline">Tous les guides <span aria-hidden="true">→</span></a></div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">{guides.slice(0, 3).map((entry) => <ArticleCard entry={entry} showDate border="border-sand-300" />)}</div>
    </div>
  </section>

  <section class="bg-sage-800 py-14 text-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-2 md:items-center">
      <div><p class="text-xs font-semibold uppercase tracking-widest text-sage-200">L’essentiel avant le matériel</p><h2 class="mt-4 text-3xl leading-snug text-white">Une maison pensée<br />pour ses petites initiatives.</h2></div>
      <div><p class="leading-relaxed text-sage-100">Un espace accessible, quelques objets bien choisis et du temps pour recommencer : l’approche Montessori peut prendre place dans les gestes du quotidien.</p><a href="/articles/preparation-environnement-montessori/" class="mt-6 inline-block rounded-lg border border-sage-300 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-sage-700">Préparer son environnement <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  {news.length > 0 && <section class="py-16 md:py-20"><div class="mx-auto max-w-6xl px-4">
    <div class="section-heading"><div><p class="eyebrow">Le journal</p><h2 class="mt-3 text-2xl md:text-3xl">Les dernières actualités</h2><p class="mt-3 text-gray-600">Montessori, éducation et petite enfance : les brèves récentes.</p></div><a href="/actualites/" class="text-sm font-semibold text-sage-700 hover:underline">Toutes les actualités <span aria-hidden="true">→</span></a></div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">{news.slice(0, 3).map((entry) => <ArticleCard entry={entry} showDate border="border-sand-300" />)}</div>
  </div></section>}

  <section class="border-t border-sand-300 bg-sand-100 py-14"><div class="mx-auto max-w-6xl px-4">
    <p class="eyebrow">Pour aller plus loin</p><h2 class="mt-3 text-2xl md:text-3xl">Des ressources pour votre quotidien</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {[{ href: '/lectures-parents/', title: 'La bibliothèque des parents', text: 'Des lectures pour comprendre la pédagogie et prendre du recul.' }, { href: '/livres-enfants/', title: 'Le plaisir des premiers livres', text: 'Explorer les albums et nourrir le goût de la lecture.' }, { href: '/ecoles/', title: 'Une école près de chez vous', text: 'Consulter notre annuaire des écoles Montessori en France.' }].map((item) => <a href={item.href} class="age-card group"><h3 class="text-lg group-hover:text-sage-700">{item.title}</h3><p class="mt-3 text-sm leading-relaxed text-gray-600">{item.text}</p><span class="mt-5 block text-sm font-semibold text-terracotta-700">Découvrir <span aria-hidden="true">→</span></span></a>)}
    </div>
  </div></section>
</BaseLayout>
