---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGuides, getNews } from '../lib/content';
import { ogCardVersion } from '../lib/og';
import { SITE, formatDate } from '../site.config';

const [guides, news] = await Promise.all([getGuides(), getNews()]);

const guidesItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Guides Montessori',
  itemListElement: guides.slice(0, 6).map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.data.title,
    url: `${SITE.url}/articles/${g.id}/`,
  })),
};

const ages = [
  { age: '0–12 mois', title: 'Les premières découvertes', text: 'Observer, toucher et explorer à son rythme.', href: '/articles/mobile-munari/', number: '01', image: '/images/mobile-munari.webp', alt: 'Bébé observant un mobile Munari' },
  { age: '1–3 ans', title: 'Faire par soi-même', text: 'Des gestes simples pour grandir en autonomie.', href: '/articles/vie-pratique/', number: '02', image: '/images/vie-pratique.webp', alt: 'Enfant faisant de la vie pratique' },
  { age: '3–6 ans', title: 'Apprendre avec ses sens', text: 'Manipuler, comparer et découvrir le langage.', href: '/articles/tour-rose/', number: '03', image: '/images/tour-rose.webp', alt: 'Enfant construisant la tour rose Montessori', featured: true },
  { age: '6 ans et plus', title: 'Explorer le monde', text: 'Nourrir la curiosité avec la géographie.', href: '/articles/globe-montessori/', number: '04', image: '/images/enfant-globe.webp', alt: 'Enfant explorant le monde avec un globe Montessori' },
];

const resources = [
  { href: '/lectures-parents/', title: 'Lectures parents', text: 'Comprendre la pédagogie à travers les livres de référence.' },
  { href: '/livres-enfants/', title: 'Livres enfants', text: 'Des albums par âge, de l’éveil aux grands récits.' },
  { href: '/ecoles/', title: 'Écoles Montessori', text: 'L’annuaire des écoles Montessori en France.' },
  { href: '/cadeaux/', title: 'Idées cadeaux', text: 'Trouver le matériel adapté, par âge et budget.' },
  { href: '/bons-plans/', title: 'Bons plans', text: 'Les offres Montessori mises à jour chaque semaine.' },
];

// Vignettes OG : on n'affiche que les brèves dont la carte est déjà générée (pas d'image cassée).
const newsWithImage = news
  .filter((n) => fs.existsSync(`public/og/actualites/${n.id}.jpg`))
  .slice(0, 4);

const featuredGuide = guides[0];
const guideList = guides.slice(1, 5);
---

<BaseLayout
  title="Montessori à la maison : activités et matériel par âge"
  description="Guides Montessori pour les 0-6 ans : activités par âge, choix du matériel et conseils concrets pour favoriser l'autonomie de votre enfant à la maison."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(guidesItemList)} />

  <!-- Hero = l'échelle d'âge -->
  <section class="home-hero">
    <div class="mx-auto max-w-6xl px-4 py-10 md:py-16">
      <h1 class="max-w-2xl text-4xl leading-tight md:text-5xl lg:text-6xl">Montessori à la maison, <span class="text-sage-700">à chaque âge son pas vers l’autonomie.</span></h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-600">
        Observer, proposer, laisser essayer : la méthode se range du plus simple au plus complexe, à hauteur d’enfant. Commencez par l’âge de votre enfant, là où il en est.
      </p>

      <h2 class="mt-8 text-2xl md:text-3xl">Où en est votre enfant ?</h2>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {ages.map((item) => (
          <a href={item.href} class:list={['age-card group', item.featured && 'age-card--featured']}>
            <img
              src={item.image}
              alt={item.alt}
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
              class="mb-4 aspect-[16/10] w-full rounded-xl object-cover"
            />
            <div class="flex items-center justify-between">
              <span class="text-sm font-semibold text-sage-700">{item.age}</span>
              <span aria-hidden="true" class="font-serif text-2xl leading-none text-sand-400">{item.number}</span>
            </div>
            <h3 class="mt-4 text-lg font-bold group-hover:text-sage-700">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{item.text}</p>
            <span class="mt-auto block pt-5 text-sm font-semibold text-terracotta-700">Explorer <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>

      <div class="mt-8 flex flex-col gap-5 border-t border-sand-300 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <a class="btn-cta" href="/articles/">Découvrir les guides <span aria-hidden="true">→</span></a>
        <p class="text-sm text-gray-600">{guides.length} guides à explorer · Accès gratuit, sans compte</p>
      </div>

      <p class="mt-6 text-sm text-gray-600">
        <span class="font-semibold text-gray-800">{SITE.author}</span>
        <span aria-hidden="true"> · </span>des guides fondés sur la pédagogie Montessori
        <span aria-hidden="true"> · </span>
        <a href="/a-propos/" class="font-semibold text-sage-700 underline-offset-2 hover:underline">Qui sommes-nous ?</a>
      </p>
    </div>
  </section>

  <!-- Guides : une grande carte + liste éditoriale -->
  <section class="py-14 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="section-heading">
        <div>
          <h2 class="text-2xl md:text-3xl">Sur l’étagère, du plus simple au plus complexe</h2>
          <p class="mt-3 max-w-2xl text-gray-600">La progression Montessori passe aussi par le matériel : chaque objet se présente quand l’enfant est prêt. Commencez par le dernier guide publié.</p>
        </div>
        <a href="/articles/" class="text-sm font-semibold text-sage-700 hover:underline">Tous les guides <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-[1.15fr_1fr]">
        {featuredGuide && (
          <a href={`/articles/${featuredGuide.id}/`} class="group block overflow-hidden rounded-2xl border border-sand-300 bg-[#fffcf8] transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="aspect-[16/9] overflow-hidden bg-sand-100">
              <img
                src={ogCardVersion(`/og/articles/${featuredGuide.id}.jpg`)}
                alt={featuredGuide.data.title}
                width="1200"
                height="630"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-5">
              <p class="mb-2 text-xs text-sage-700"><time datetime={featuredGuide.data.publishDate.toISOString()}>{formatDate(featuredGuide.data.publishDate)}</time></p>
              <h3 class="font-serif text-lg font-bold text-gray-800 transition-colors group-hover:text-sage-600">{featuredGuide.data.title}</h3>
              <p class="mt-1 line-clamp-2 text-sm text-gray-600">{featuredGuide.data.description}</p>
              <span class="mt-3 inline-block text-sm font-semibold text-terracotta-700">Lire le guide <span aria-hidden="true">→</span></span>
            </div>
          </a>
        )}
        <div class="flex flex-col">
          {guideList.map((entry) => (
            <a href={`/articles/${entry.id}/`} class="group flex items-center gap-4 border-b border-sand-300 py-4 first:pt-0 last:border-b-0 last:pb-0">
              <img
                src={ogCardVersion(`/og/articles/${entry.id}.jpg`)}
                alt=""
                width="1200"
                height="630"
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-28 shrink-0 rounded-lg object-cover"
              />
              <span class="block min-w-0">
                <span class="block font-serif text-base font-bold text-gray-900 group-hover:text-sage-700">{entry.data.title}</span>
                <span class="mt-1 block text-sm leading-relaxed text-gray-600 line-clamp-2">{entry.data.description}</span>
              </span>
              <span aria-hidden="true" class="ml-auto shrink-0 text-lg text-sage-700 transition-transform group-hover:translate-x-1">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Respiration verte : vers un guide précis -->
  <section class="bg-sage-800 py-14 text-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="text-3xl leading-snug text-white">Tout commence par l’environnement.</h2>
        <p class="mt-4 leading-relaxed text-sage-100">Avant le matériel, il y a l’espace : une étagère à hauteur d’enfant, un plateau accessible, des gestes que l’enfant peut refaire seul. Notre guide détaille la méthode, pièce par pièce.</p>
      </div>
      <div class="flex flex-col items-start gap-5 md:items-end">
        <ul class="space-y-2 text-sage-100">
          <li class="flex gap-2"><span aria-hidden="true">·</span> L’étagère basse, accessible sans aide</li>
          <li class="flex gap-2"><span aria-hidden="true">·</span> Le plateau prêt à l’emploi</li>
          <li class="flex gap-2"><span aria-hidden="true">·</span> L’ordre : chaque chose à sa place</li>
        </ul>
        <a href="/articles/preparation-environnement-montessori/" class="inline-block rounded-lg border border-sage-300 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-sage-700">Préparer son environnement <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Actualités : bandeau éditorial avec vignettes -->
  {newsWithImage.length > 0 && (
    <section class="border-t border-sand-300 bg-sand-100 py-14">
      <div class="mx-auto max-w-6xl px-4">
        <div class="section-heading">
          <div>
            <h2 class="text-2xl md:text-3xl">Les dernières actualités</h2>
            <p class="mt-3 text-gray-600">Montessori, éducation et petite enfance : les brèves récentes.</p>
          </div>
          <a href="/actualites/" class="text-sm font-semibold text-sage-700 hover:underline">Toutes les actualités <span aria-hidden="true">→</span></a>
        </div>
        <ul class="mt-6 grid gap-x-8 md:grid-cols-2">
          {newsWithImage.map((entry) => (
            <li>
              <a href={`/actualites/${entry.id}/`} class="group flex items-center gap-4 border-b border-sand-300 py-3">
                <img
                  src={ogCardVersion(`/og/actualites/${entry.id}.jpg`)}
                  alt=""
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-lg object-cover"
                />
                <span class="block min-w-0">
                  <span class="block font-serif text-base font-bold text-gray-900 group-hover:text-sage-700">{entry.data.title}</span>
                  <time datetime={entry.data.publishDate.toISOString()} class="mt-1 block text-xs text-gray-600">{formatDate(entry.data.publishDate)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Ressources : bandeau de liens -->
  <section class="py-14 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl md:text-3xl">Pour aller plus loin</h2>
      <div class="mt-6 flex flex-col divide-y divide-sand-300 overflow-hidden rounded-2xl border border-sand-300 bg-[#fffcf8] lg:flex-row lg:divide-x lg:divide-y-0">
        {resources.map((item) => (
          <a href={item.href} class="group flex-1 px-5 py-4 transition-colors hover:bg-sand-50">
            <span class="font-serif text-base font-bold text-gray-900 group-hover:text-sage-700">{item.title}</span>
            <span class="mt-1 block text-sm leading-relaxed text-gray-600">{item.text}</span>
            <span class="mt-3 inline-block text-sm font-semibold text-terracotta-700">Découvrir <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
