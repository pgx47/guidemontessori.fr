---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { booksFor } from '../data/books';

const books = booksFor('parent');

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Lectures pour Parents',
  itemListElement: books.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.title,
  })),
};
---

<BaseLayout title={"Livres Montessori pour les parents : comprendre la pédagogie"} description={"Les livres Montessori indispensables aux parents : comprendre la pédagogie, aménager la maison et accompagner l'autonomie de l'enfant au quotidien."} keywords={['livres montessori', 'éducation parents', 'Maria Montessori livres', 'pédagogie bienveillante']}>
<script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />
<div class="py-12 bg-warm">
    <div class="max-w-4xl mx-auto px-4">
        {/* Header */}
        <header class="text-center mb-12">
            <span class="text-5xl mb-4 block">📚</span>
            <h1 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mb-4">
                Lectures pour Parents
            </h1>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Notre sélection des meilleurs livres pour comprendre et appliquer
                la pédagogie Montessori à la maison.
            </p>
        </header>


        <nav class="mb-8 flex flex-wrap justify-center gap-2">
          <a href="#essentiels" class="rounded-full border border-sage-300 px-4 py-1.5 text-xs font-bold text-sage-700 hover:bg-sage-50">Essentiels</a>
          <a href="#approfondi" class="rounded-full border border-sage-300 px-4 py-1.5 text-xs font-bold text-sage-700 hover:bg-sage-50">Théorie</a>
          <a href="#pratique" class="rounded-full border border-sage-300 px-4 py-1.5 text-xs font-bold text-sage-700 hover:bg-sage-50">Pratique</a>
        </nav>

        <section class="mb-10 rounded-xl border border-sage-200 bg-sage-50 p-6">
            <h2 class="font-serif text-lg font-bold text-gray-800 mb-2">📚 Par où commencer ?</h2>
            <p class="text-sm text-gray-700">Nouveau dans la pédagogie ? Commencez par <strong>"L'Enfant"</strong> pour comprendre la philosophie, complété par <strong>"100 activités Montessori"</strong> pour la mise en pratique immédiate.</p>
        </section>

        {/* Introduction */}
        <section class="bg-white rounded-xl p-6 mb-10 shadow-sm">
            <blockquote class="text-lg italic text-gray-600 border-l-4 border-sage-400 pl-4">
                "L'éducation est une arme de paix." — Maria Montessori
            </blockquote>
            <p class="mt-4 text-gray-700">
                Avant d'investir dans le matériel, nous vous recommandons de lire au moins
                un ouvrage de Maria Montessori elle-même. Comprendre la <strong>philosophie</strong>
                derrière les activités transformera votre approche.
            </p>
        </section>

        {/* Les Essentiels */}
        <section id="essentiels" class="mb-12">
            <h2 class="text-2xl font-serif font-bold text-sage-700 mb-6">
                📖 Les Ouvrages Essentiels de Maria Montessori
            </h2>
            <div class="grid gap-6 md:grid-cols-2">
                {books.filter((b) => b.level === "Essentiel").map((book) => <BookCard book={book} badgeClass="bg-terracotta-100 text-terracotta-700" />)}
            </div>
        </section>

        {/* Pour Aller Plus Loin */}
        <section class="mb-12">
            <h2 class="text-2xl font-serif font-bold text-sage-700 mb-6">
                🎓 Pour Approfondir
            </h2>
            <div class="grid gap-6 md:grid-cols-2">
                {books.filter((b) => b.level === "Approfondi").map((book) => <BookCard book={book} badgeClass="bg-sage-100 text-sage-700" />)}
            </div>
        </section>

        {/* Guides Pratiques */}
        <section class="mb-12">
            <h2 class="text-2xl font-serif font-bold text-sage-700 mb-6">
                🛠️ Guides Pratiques
            </h2>
            <div class="grid gap-6 md:grid-cols-2">
                {books.filter((b) => b.level === "Pratique").map((book) => <BookCard book={book} badgeClass="bg-blue-100 text-blue-700" />)}
            </div>
        </section>

        {/* CTA */}
        <section class="bg-sage-50 rounded-xl p-8 text-center">
            <h3 class="text-xl font-serif font-bold text-gray-900 mb-3">
                Par Où Commencer ?
            </h3>
            <p class="text-gray-600 mb-4">
                Nous recommandons de commencer par <strong>"L'Enfant"</strong> de Maria Montessori,
                puis d'enchaîner avec un guide pratique comme <strong>"100 Activités Montessori"</strong>.
            </p>
            <a
                href="https://www.amazon.fr/dp/2220057739?tag=mtssri-21"
                target="_blank"
                rel="nofollow sponsored noopener"
                class="btn-cta"
            >
                Découvrir "L'Enfant" sur Amazon →
            </a>
        </section>

        {/* Navigation */}
        <div class="mt-10 text-center">
            <a href="/livres-enfants/" class="text-sage-600 hover:underline mr-6">
                Livres pour Enfants →
            </a>
            <a href="/articles/" class="text-sage-600 hover:underline">
                ← Retour aux articles
            </a>
        </div>
    </div>
</div>
</BaseLayout>
